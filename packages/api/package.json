{
  "name": "@hamhome/api",
  "version": "1.0.0",
  "private": true,
  "description": "HamHome 后端 API (Cloudflare Workers + Hono)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "register-subdomain": "node scripts/register-workers-dev-subdomain.mjs",
    "clean": "rm -rf dist",
    "d1:migrate:0003": "wrangler d1 execute hamhome-db --remote --file=../../packages/db/migrations/d1/0003_digest_subscriptions.sql",
    "d1:migrate:0004": "wrangler d1 execute hamhome-db --remote --file=../../packages/db/migrations/d1/0004_digest_subscription_limits.sql",
    "d1:migrate:subscriptions": "pnpm run d1:migrate:0003 && pnpm run d1:migrate:0004",
    "deploy:prod": "wrangler deploy",
    "release": "node ./scripts/release.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.0.0",
    "@hono/zod-validator": "^0.2.0",
    "zod": "^3.22.0",
    "nanoid": "^5.0.0",
    "drizzle-orm": "^0.30.0",
    "@hamhome/db": "workspace:*",
    "@hamhome/types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "wrangler": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
